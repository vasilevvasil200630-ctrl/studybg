# ========================================================
# StudyBG - Environment Variables Configuration
# ========================================================
# В момента сайтът работи 100% автономно БЕЗ нито един ключ!
# Когато решите да свържете платен AI модел и база данни,
# копирайте този файл като .env.local и попълнете стойностите:

# 1. Изкуствен интелект (Мултимодално четене на снимки от тетрадки):
# Вземете безплатен или платен ключ от: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Алтернатива: OpenAI API ключ от: https://platform.openai.com/
VITE_OPENAI_API_KEY=your_openai_api_key_here

# 2. Облачна база данни и акаунти на учениците (по избор, напр. Supabase):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Публичен домейн на сайта (за споделяне и SEO):
VITE_APP_URL=https://studybg.vercel.app
